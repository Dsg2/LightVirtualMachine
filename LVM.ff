# virutal machine runtime environment
# mindustry/assembly inspired programming syntax
#
# Virtual machine specs:
# Interprets a language with syntax inspired by mindustry/assembly, aiming for a minimalstic but powerful language. The runtime is optimised with switch cases, and no runtime error checking for maximimum efficiency.
# - 240x135 screen default
# - 64 default data cells (data cells accessed as c<index>), changing length of memory planned
# - 16 default jmp label table, changing length of jmp table planned
# - currently framebuffer not exposed directly, includes high level vga-inspired text display mode (char is 3x5 + 1 space, padding gives 236x131 usable space, 56 column and 21 row), planned for raw pixel manipulation
#
# builtins:
# lab <cell|num> - creates a label with value at cell or num
# mov <dest> <source> - copies source (cell or num) to dest, dest must be cell
# add/sub/mul/div/mod <cell> <cell|num> - does arithmetic, stores output to first cell (must be cell)
# jmp <lab> <cond>- jumps to label (cell or num) if cond cell is not 0
# vga <ind> <char ind> - writes to screen location ind with value char ind (char ind is line index of vga.dat)
# key <char ind> <cell> - gets key is down at char ind (cell or num, based off vga.dat line index), stored to out cell
# slp <cell|num> - sleeps for time in seconds
# hlt - halts (ends the runtime)
#
# logic:
# 

def fbi(x, y):
    global w, s
    return int(x * s + y * w * s * s) * 4

if exists("config") == 0:
    g = zeros(2)
    g[0] = 64
    g[1] = 16
    save_list("config", g)
g = load_list("config")

memlen = g[0]
jmplen = g[1]

mem = zeros(memlen)
jt = zeros(jmplen)

w = 240
h = 135
s = 2
win = window(w * s, h * s, "LVMrt")
fb = zeros(w * s * h * s * 4)
vgabnk = read_file("vga.dat")
vgadat = zeros(int(95 * 15))
ct = 0
j = 0
print("loading vga font data")
for i in range(strlen(vgabnk)):
    if streq(strsub(vgabnk, i, 1), '\n'):
        j = 0
    else:
        j = j + 1
        if (streq(strsub(vgabnk, i, 1), '0') or streq(strsub(vgabnk, i, 1), '1')) and j != 1:
            vgadat[ct] = toint(strsub(vgabnk, i, 1))
            ct = ct + 1
vgabnk = ""
print(ct)
print("done")

# --- parallelism runtime (CPU threads + GPU expression megakernel) ---
kernel gexec = load("gexec.cl", "gexec")
lock0 = mutex()
lock1 = mutex()
lock2 = mutex()
lock3 = mutex()
gprog = zeros(0)      # gexec micro-program, flat pairs [opcode, arg]
gconst = zeros(0)     # gexec constant pool
gins = zeros(0)       # gexec bound input bases (mem region starts)
VLEN = 0              # active gexec vector length
userline = ""         # last line typed via the `inp` opcode
mblob = blob_open("C:\\llama\\LFM2.5-350M-Q8_0.gguf")   # mmap'd LFM2 GGUF
memb_off = 0          # abs byte offset of token_embd Q8_0 tensor data
n_embd = 0            # embedding dim (ne[0] of token_embd)

def pix(fbi, r, g, b):
    global fb, w, s
    for i in range(s):
        for j in range(s):
            off = fbi + (j + i * w * s) * 4
            fb[off] = r
            fb[off + 1] = g
            fb[off + 2] = b
            fb[off + 3] = 1.0

def vga(x, y, ch):
    global w, s, fb, vgadat
    ind = int(((x % 56) * 4 + 2 + ((y % 21) * 6 + 2) * w * s) * s * 4)
    if ch >= 0:
        for a in range(5):
            for b in range(3):
                c = float(1.0 * vgadat[int(ch * 15 + a * 3 + b)])
                pix(int(ind + fbi(b, a)), c, c, c)

def vgalookup(ch):
    return strfind(" `1234567890-=qwertyuiop[]\\asdfghjkl;'zxcvbnm,./~!@#$%^&*()_+QWERTYUIOP{}|ASDFGHJKL:\"ZXCVBNM<>?", ch)

def txt(x, y, t:str):
    for i in range(strlen(t)):
        vga(x + i, y, vgalookup(strsub(t, i, 1)))

def scr(m, c):
    global l, lc, g
    switch m:
        case 0:
            txt(0, 0, "Light Virtual Machine")
            switch c:
                case 0:
                    txt(0, 2, "> boot")
                    txt(0, 3, "  configure machine")
                    txt(0, 4, "  exit")
                case 1:
                    txt(0, 2, "  boot")
                    txt(0, 3, "> configure machine")
                    txt(0, 4, "  exit")
                case 2:
                    txt(0, 2, "  boot")
                    txt(0, 3, "  configure machine")
                    txt(0, 4, "> exit")
        case 1:
            txt(0, 0, "Select kernel")
            j = 0
            for i in range(int(len(lc) / 2)):
                if i == c:
                    sp = "> "
                else:
                    sp = "  "
                txt(0, i + 2, strcat(sp, strsub(l, lc[i * 2], lc[i * 2 + 1])))
                j = i
            if c == int(len(lc) * 0.5):
                txt(0, j + 3, "> back")
            else:
                txt(0, j + 3, "  back")
        case 2:
            txt(0, 0, "configure virtual machine (exit and restart to take effect)")
            switch c:
                case 0:
                    txt(0, 2, strcat(strcat("> change registers size", str(g[0])), "        "))
                    txt(0, 3, "  change jump table size         ")
                    txt(0, 4, "  back")
                case 1:
                    txt(0, 2, "  change registers size         ")
                    txt(0, 3, strcat(strcat("> change jump table size", str(g[1])), "        "))
                    txt(0, 4, "  back")
                case 2:
                    txt(0, 2, "  change registers size         ")
                    txt(0, 3, "  change jump table size         ")
                    txt(0, 4, "> back")

def getkeys():
    global win, k
    o = zeros(5)
    if win.key("left") and k[0] == 0:
        o[0] = 1
    if win.key("up") and k[1] == 0:
        o[1] = 1
    if win.key("right") and k[2] == 0:
        o[2] = 1
    if win.key("down") and k[3] == 0:
        o[3] = 1
    if win.key("enter") and k[4] == 0:
        o[4] = 1
    k[0] = win.key("left")
    k[1] = win.key("up")
    k[2] = win.key("right")
    k[3] = win.key("down")
    k[4] = win.key("enter")
    return o

# --- operand decode / GPU helpers / CPU worker ---
# Main-thread operand decode: cell in [0,memlen), immediate in [memlen,..)-memlen,
# negative used directly. (mirrors the inline decode in the run loop)
def rdm(v):
    global mem, memlen
    if v >= memlen:
        return v - memlen
    if v >= 0:
        return mem[int(v)]
    return v

# Worker operand decode with a private window: cells [0,PRIV) are per-worker
# scratch (local list `priv`), cells [PRIV,memlen) are shared `mem`.
def rd(v, priv, mem, memlen, PRIV):
    if v >= memlen:
        return v - memlen
    if v >= PRIV:
        return mem[int(v)]
    if v >= 0:
        return priv[int(v)]
    return v

def wr(d, val, priv, mem, PRIV):
    if d >= PRIV:
        mem[int(d)] = val
    else:
        priv[int(d)] = val

# Pack the bound input mem-regions into one contiguous buffer for gexec:
#   inbuf[slot*vlen + e] = mem[base_slot + e]
def gpack(gins, mem, vlen):
    numvecs = len(gins)
    inbuf = zeros(int(numvecs * vlen))
    for si in range(numvecs):
        base = int(gins[si])
        for e in range(vlen):
            inbuf[int(si * vlen + e)] = mem[int(base + e)]
    return inbuf

def gunpack(outbuf, mem, obase, vlen):
    for e in range(vlen):
        mem[int(obase + e)] = outbuf[e]

# CPU worker: runs the compute-only subset of the ISA over shared `mem`, from
# instruction `ip0`, for every logical id it owns (tid0, tid0+P, ...). Rendering
# / IO / GPU ops are main-thread only and are skipped here.
def core(a, a1, a2, mem, jt, ip0, tid0, count, memlen):
    global lock0, lock1, lock2, lock3
    PRIV = 16
    P = 4
    lid = tid0
    ic = 0
    while lid < count:
        priv = zeros(PRIV)
        ip = ip0
        running = 1
        while running:
            op = a[int(ip)]
            m1 = a1[int(ip)]
            m2 = a2[int(ip)]
            if op == 1:
                wr(m1, rd(m2, priv, mem, memlen, PRIV), priv, mem, PRIV)
                ip = ip + 1
            elif op == 2:
                wr(m1, rd(m1, priv, mem, memlen, PRIV) + rd(m2, priv, mem, memlen, PRIV), priv, mem, PRIV)
                ip = ip + 1
            elif op == 3:
                wr(m1, rd(m1, priv, mem, memlen, PRIV) - rd(m2, priv, mem, memlen, PRIV), priv, mem, PRIV)
                ip = ip + 1
            elif op == 4:
                wr(m1, rd(m1, priv, mem, memlen, PRIV) * rd(m2, priv, mem, memlen, PRIV), priv, mem, PRIV)
                ip = ip + 1
            elif op == 5:
                wr(m1, rd(m1, priv, mem, memlen, PRIV) / rd(m2, priv, mem, memlen, PRIV), priv, mem, PRIV)
                ip = ip + 1
            elif op == 6:
                wr(m1, rd(m1, priv, mem, memlen, PRIV) % rd(m2, priv, mem, memlen, PRIV), priv, mem, PRIV)
                ip = ip + 1
            elif op == 7:
                if rd(m2, priv, mem, memlen, PRIV) != 0:
                    if m1 >= memlen:
                        ip = jt[int(m1 - memlen)]
                    elif m1 >= 0:
                        ip = jt[int(mem[int(m1)])]
                    else:
                        ip = jt[int(m1)]
                else:
                    ip = ip + 1
            elif op == 15:
                wr(m2, lid, priv, mem, PRIV)
                ip = ip + 1
            elif op == 16:
                lk = int(rd(m2, priv, mem, memlen, PRIV))
                if lk == 0:
                    lock0.lock()
                elif lk == 1:
                    lock1.lock()
                elif lk == 2:
                    lock2.lock()
                else:
                    lock3.lock()
                ip = ip + 1
            elif op == 17:
                lku = int(rd(m2, priv, mem, memlen, PRIV))
                if lku == 0:
                    lock0.unlock()
                elif lku == 1:
                    lock1.unlock()
                elif lku == 2:
                    lock2.unlock()
                else:
                    lock3.unlock()
                ip = ip + 1
            elif op == 14:
                running = 0
            elif op == 12:
                running = 0
            else:
                ip = ip + 1
            ic = ic + 1
        lid = lid + P
    return ic

# --- interactive LLM chat helpers (drive external g4run engine) ---
def clrrow(row):
    for xx in range(56):
        vga(xx, row, 0)

# draw string t starting at text row `row`, wrapping at 56 cols and on '\n',
# clearing rows row..20 first
def showstr(t: str, row):
    for ry in range(row, 21):
        clrrow(ry)
    cx = 0
    cy = row
    for i in range(strlen(t)):
        ch = strsub(t, i, 1)
        if streq(ch, '\n'):
            cx = 0
            cy = cy + 1
        else:
            if cy < 21:
                vga(cx, cy, vgalookup(ch))
            cx = cx + 1
            if cx >= 56:
                cx = 0
                cy = cy + 1

# blocking single-line editor at text row `row`; returns the typed string
def readline(row):
    global win, fb, w, s, h
    ks = "abcdefghijklmnopqrstuvwxyz0123456789"
    buf = ""
    editing = 1
    while editing and win.open:
        for i in range(strlen(ks)):
            ch = strsub(ks, i, 1)
            if win.key_pressed(ch):
                buf = strcat(buf, ch)
        if win.key_pressed("space"):
            buf = strcat(buf, " ")
        if win.key_pressed("backspace"):
            if strlen(buf) > 0:
                buf = strsub(buf, 0, strlen(buf) - 1)
        if win.key_pressed("enter"):
            editing = 0
        clrrow(row)
        txt(0, row, strcat("> ", buf))
        win.draw(fb, w * s, h * s)
        win.tick(30)
    return buf

# --- GGUF (LFM2, Q8_0) model loading, in pure FFLang ---
# byte size of a scalar GGUF metadata value type
def gsz(t):
    if t == 0:
        return 1
    if t == 1:
        return 1
    if t == 2:
        return 2
    if t == 3:
        return 2
    if t == 4:
        return 4
    if t == 5:
        return 4
    if t == 6:
        return 4
    if t == 7:
        return 1
    if t == 10:
        return 8
    if t == 11:
        return 8
    if t == 12:
        return 8
    return 4

# advance past one metadata value of type t at offset o; return new offset
def gskipval(o, t):
    global mblob
    b = mblob
    if t == 8:
        return o + 8 + blob_u64(b, o)
    if t == 9:
        et = blob_u32(b, o)
        ln = blob_u64(b, o + 4)
        o = o + 12
        if et == 8:
            zk = 0
            while zk < ln:
                o = o + 8 + blob_u64(b, o)
                zk = zk + 1
            return o
        return o + gsz(et) * ln
    return o + gsz(t)

# parse the GGUF header + tensor directory; record token_embd offset/dim
def gguf_parse():
    global mblob, memb_off, n_embd
    b = mblob
    if blob_size(b) >= 32:
        nt = blob_u64(b, 8)
        nkv = blob_u64(b, 16)
        o = 24
        kv = 0
        while kv < nkv:
            o = o + 8 + blob_u64(b, o)
            vt = blob_u32(b, o)
            o = o + 4
            o = gskipval(o, vt)
            kv = kv + 1
        embo = 0
        ne = 0
        ti = 0
        while ti < nt:
            nl = blob_u64(b, o)
            name = blob_str(b, o + 8, nl)
            o = o + 8 + nl
            nd = blob_u32(b, o)
            o = o + 4
            d0 = blob_u64(b, o)
            o = o + nd * 8
            o = o + 4
            toff = blob_u64(b, o)
            o = o + 8
            if streq(name, "token_embd.weight"):
                embo = toff
                ne = d0
            ti = ti + 1
        memb_off = int((o + 31) / 32) * 32 + embo
        n_embd = ne

# dequantize token `tok`'s Q8_0 embedding row into mem[base .. base+n_embd)
def load_emb(tok, base):
    global mblob, memb_off, n_embd, mem
    b = mblob
    nblk = int(n_embd / 32)
    blk0 = int(tok * n_embd / 32)
    bi = 0
    while bi < nblk:
        bo = memb_off + (blk0 + bi) * 34
        sc = blob_f16(b, bo)
        j = 0
        while j < 32:
            q = blob_u8(b, bo + 2 + j)
            if q >= 128:
                q = q - 256
            mem[int(base + bi * 32 + j)] = q * sc
            j = j + 1
        bi = bi + 1

