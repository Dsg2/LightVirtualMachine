# virutal machine runtime environment
# mindustry/assembly inspired programming syntax
#
# Virtual machine specs:
# Interprets a language with syntax inspired by mindustry/assembly, aiming for a minimalstic but powerful language. The runtime is optimised with switch cases, and no runtime error checking for maximimum efficiency.
# - 240x135 screen default
# - 64 default data cells (data cells accessed as c<index>), changing length of memory planned
# - 16 default jmp label table, changing length of jmp table planned
# - currently framebuffer not exposed directly, includes high level vga-inspired text display mode (char is 3x5 + 1 space, padding gives 236x131 usable space, 56 column and 21 row), planned for raw pixel manipulation
#
# builtins:
# lab <cell|num> - creates a label with value at cell or num
# mov <dest> <source> - copies source (cell or num) to dest, dest must be cell
# add/sub/mul/div/mod <cell> <cell|num> - does arithmetic, stores output to first cell (must be cell)
# jmp <lab> <cond>- jumps to label (cell or num) if cond cell is not 0
# vga <ind> <char ind> - writes to screen location ind with value char ind (char ind is line index of vga.dat)
# key <char ind> <cell> - gets key is down at char ind (cell or num, based off vga.dat line index), stored to out cell
# slp <cell|num> - sleeps for time in seconds
# hlt - halts (ends the runtime)
#
# logic:
# 

def fbi(x, y):
    global w, s
    return int(x * s + y * w * s * s) * 4

if exists("config") == 0:
    g = zeros(2)
    g[0] = 64
    g[1] = 16
    save_list("config", g)
g = load_list("config")

memlen = g[0]
jmplen = g[1]

mem = zeros(memlen)
jt = zeros(jmplen)

w = 240
h = 135
s = 2
win = window(w * s, h * s, "LVMrt")
fb = zeros(w * s * h * s * 4)
vgabnk = read_file("vga.dat")
vgadat = zeros(int(95 * 15))
ct = 0
j = 0
print("loading vga font data")
for i in range(strlen(vgabnk)):
    if streq(strsub(vgabnk, i, 1), '\n'):
        j = 0
    else:
        j = j + 1
        if (streq(strsub(vgabnk, i, 1), '0') or streq(strsub(vgabnk, i, 1), '1')) and j != 1:
            vgadat[ct] = toint(strsub(vgabnk, i, 1))
            ct = ct + 1
vgabnk = ""
print(ct)
print("done")

def pix(fbi, r, g, b):
    global fb, w, s
    for i in range(s):
        for j in range(s):
            off = fbi + (j + i * w * s) * 4
            fb[off] = r
            fb[off + 1] = g
            fb[off + 2] = b
            fb[off + 3] = 1.0

def vga(x, y, ch):
    global w, s, fb, vgadat
    ind = int(((x % 56) * 4 + 2 + ((y % 21) * 6 + 2) * w * s) * s * 4)
    if ch >= 0:
        for a in range(5):
            for b in range(3):
                c = float(1.0 * vgadat[int(ch * 15 + a * 3 + b)])
                pix(int(ind + fbi(b, a)), c, c, c)

def vgalookup(ch):
    return strfind(" `1234567890-=qwertyuiop[]\\asdfghjkl;'zxcvbnm,./~!@#$%^&*()_+QWERTYUIOP{}|ASDFGHJKL:\"ZXCVBNM<>?", ch)

def txt(x, y, t:str):
    for i in range(strlen(t)):
        vga(x + i, y, vgalookup(strsub(t, i, 1)))

def scr(m, c):
    global l, lc
    switch m:
        case 0:
            txt(0, 0, "Light Virtual Machine")
            switch c:
                case 0:
                    txt(0, 2, "> boot")
                    txt(0, 3, "  configure machine")
                    txt(0, 4, "  exit")
                case 1:
                    txt(0, 2, "  boot")
                    txt(0, 3, "> configure machine")
                    txt(0, 4, "  exit")
                case 2:
                    txt(0, 2, "  boot")
                    txt(0, 3, "  configure machine")
                    txt(0, 4, "> exit")
        case 1:
            txt(0, 0, "Select kernel")
            j = 0
            for i in range(int(len(lc) / 2)):
                if i == c:
                    sp = "> "
                else:
                    sp = "  "
                txt(0, i + 2, strcat(sp, strsub(l, lc[i * 2], lc[i * 2 + 1])))
                j = i
            if c == int(len(lc) * 0.5):
                txt(0, j + 3, "> back")
            else:
                txt(0, j + 3, "  back")
        case 2:
            txt(0, 0, "configure virtual machine")
            switch c:
                case 0:
                    txt(0, 2, strcat("> change registers size", ""))
                    txt(0, 3, "  back")
                case 1:
                    txt(0, 2, strcat("  change registers size", ""))
                    txt(0, 3, "> back")

def getkeys():
    global win, k
    o = zeros(5)
    if win.key("left") and k[0] == 0:
        o[0] = 1
    if win.key("up") and k[1] == 0:
        o[1] = 1
    if win.key("right") and k[2] == 0:
        o[2] = 1
    if win.key("down") and k[3] == 0:
        o[3] = 1
    if win.key("enter") and k[4] == 0:
        o[4] = 1
    k[0] = win.key("left")
    k[1] = win.key("up")
    k[2] = win.key("right")
    k[3] = win.key("down")
    k[4] = win.key("enter")
    return o

c = 0
m = 0
scr(m, c)
k = zeros(5)
l = ""
lc = zeros(1)
r = 1
while r:
    r = win.open
    keys = getkeys()
    switch m:
        case 0:
            c = clamp(c - keys[1] + keys[3], 0, 2)
            switch c:
                case 0:
                    if keys[4]:
                        l = list_dir("./kernels")
                        lc = zeros(0)
                        ca = 0
                        for i in range(strlen(l)):
                            if streq(strsub(l, i, 1), '\n'):
                                lc.append(ca)
                                lc.append(i - ca)
                                ca = i + 1
                        if ca < strlen(l):
                            lc.append(ca)
                            lc.append(strlen(l) - ca)
                        c = 0
                        m = 1
                        fb = zeros(w * s * h * s * 4)
                case 1:
                    if keys[4]:
                        c = 0
                        m = 2
                        fb = zeros(w * s * h * s * 4)
                case 2:
                    if keys[4]:
                        r = 0
        case 1:
            c = clamp(c - keys[1] + keys[3], 0, int(len(lc) * 0.5))
            if c == int(len(lc) * 0.5):
                if keys[4]:
                    c = 0
                    m = 0
                    fb = zeros(w * s * h * s * 4)
            else:
                if keys[4]:
                    fb = zeros(w * s * h * s * 4)
                    if exists(strcat("kernels/", strsub(l, lc[c * 2], lc[c * 2 + 1]))):
                        dat = read_file(strcat("kernels/", strsub(l, lc[c * 2], lc[c * 2 + 1])))
                        dati = zeros(1)
                        ca = 0
                        for i in range(strlen(dat)):
                            if streq(strsub(dat, i, 1), '\n'):
                                dati.append(ca)
                                dati.append(i + 1)
                                ca = 0
                            else:
                                ca = ca + 1
                        dati.append(ca)
                        ki = zeros(0)
                        for i in range(int(len(dati) * 0.5)):
                            lo = dati[i * 2]
                            ll = dati[i * 2 + 1]
                            p = strsub(dat, lo, ll)
                            ca = 0
                            while ca < ll:
                                while ca < ll and (streq(strsub(p, ca, 1), ' ') or streq(strsub(p, ca, 1), ',')):
                                    ca = ca + 1
                                j = 0
                                while j + ca < ll and streq(strsub(p, j + ca, 1), ' ') != 1 and streq(strsub(p, j + ca, 1), ',') != 1:
                                    j = j + 1
                                if j > 0:
                                    ki.append(lo + ca)
                                    ki.append(j)
                                ca = ca + j + 1
                        i = 0
                        ca = 0
                        kw = "labmovaddsubmuldivmodjmpvgakeyslphlt"
                        tl = "122222222210"
                        t = 0
                        v = ""
                        a = zeros(0)
                        a1 = zeros(0)
                        a2 = zeros(0)
                        ti = 0
                        while ti < int(len(ki) * 0.5):
                            v = strsub(dat, ki[ti * 2], ki[ti * 2 + 1])
                            if t == 0:
                                if len(a1) < len(a):
                                    a1.append(0)
                                if len(a2) < len(a):
                                    a2.append(0)
                                u = -1
                                for i in range(int(strlen(kw) / 3)):
                                    if streq(strsub(kw, i * 3, 3), v):
                                        u = i
                                        t = toint(strsub(tl, i, 1))
                                        break
                                if u == -1:
                                    ca = 1
                                    print(strcat("invalid keyword: ", v))
                                    txt(0, 0, strcat(strcat("keyword '", v), "' is invalid"))
                                    win.draw(fb, w * s, h * s)
                                    win.tick()
                                    sleep(2)
                                    fb = zeros(w * s * h * s * 4)
                                    break
                                a.append(u)
                            elif t == 1:
                                if streq(strsub(v, 0, 1), "c"):
                                    a2.append(toint(strsub(v, 1)))
                                else:
                                    if tofloat(v) >= 0:
                                        a2.append(tofloat(v) + memlen)
                                    else:
                                        a2.append(tofloat(v))
                                t = t - 1
                            elif t == 2:
                                if streq(strsub(v, 0, 1), "c"):
                                    a1.append(toint(strsub(v, 1)))
                                else:
                                    if tofloat(v) >= 0:
                                        a1.append(tofloat(v) + memlen)
                                    else:
                                        a1.append(tofloat(v))
                                t = t - 1
                            ti = ti + 1
                        if len(a1) < len(a):
                            a1.append(0)
                        if len(a2) < len(a):
                            a2.append(0)
                        print(a)
                        print(a1)
                        print(a2)
                        if len(dat) > 0:
                            if ca == 0:
                                i = 0
                                for i in range(memlen):
                                    mem[i] = 0
                                for i in range(jmplen):
                                    jt[i] = 0
                                i = 0.0
                                it = 0.0
                                tt = 0.0
                                lt = time()
                                la = len(a)
                                d = 0
                                fc = 0
                                while r and win.open:
                                    ma1 = a1[i]
                                    ma2 = a2[i]
                                    f1 = 0
                                    f2 = 0
                                    switch a[i]:
                                        case 0:
                                            if ma2 >= memlen:
                                                jt[ma2 - memlen] = i
                                            elif ma2 >= 0:
                                                jt[mem[ma2]] = i
                                            else:
                                                jt[ma2] = i
                                            i = i + 1
                                        case 1:
                                            if ma2 >= memlen:
                                                f1 = ma2 - memlen
                                            elif ma2 >= 0:
                                                f1 = mem[ma2]
                                            else:
                                                f1 = ma2
                                            mem[ma1] = f1
                                            i = i + 1
                                        case 2:
                                            if ma2 >= memlen:
                                                f1 = ma2 - memlen
                                            elif ma2 >= 0:
                                                f1 = mem[ma2]
                                            else:
                                                f1 = ma2
                                            mem[ma1] = mem[ma1] + f1
                                            i = i + 1
                                        case 3:
                                            if ma2 >= memlen:
                                                f1 = ma2 - memlen
                                            elif ma2 >= 0:
                                                f1 = mem[ma2]
                                            else:
                                                f1 = ma2
                                            mem[ma1] = mem[ma1] - f1
                                            i = i + 1
                                        case 4:
                                            if ma2 >= memlen:
                                                f1 = ma2 - memlen
                                            elif ma2 >= 0:
                                                f1 = mem[ma2]
                                            else:
                                                f1 = ma2
                                            mem[ma1] = mem[ma1] * f1
                                            i = i + 1
                                        case 5:
                                            if ma2 >= memlen:
                                                f1 = ma2 - memlen
                                            elif ma2 >= 0:
                                                f1 = mem[ma2]
                                            else:
                                                f1 = ma2
                                            mem[ma1] = mem[ma1] / f1
                                            i = i + 1
                                        case 6:
                                            if ma2 >= memlen:
                                                f1 = ma2 - memlen
                                            elif ma2 >= 0:
                                                f1 = mem[ma2]
                                            else:
                                                f1 = ma2
                                            mem[ma1] = mem[ma1] % f1
                                            i = i + 1
                                        case 7:
                                            if ma2 >= memlen:
                                                f1 = ma2 - memlen
                                            elif ma2 >= 0:
                                                f1 = mem[ma2]
                                            else:
                                                f1 = ma2
                                            if f1 != 0:
                                                if ma1 >= memlen:
                                                    i = jt[ma1 - memlen]
                                                elif ma1 >= 0:
                                                    i = jt[mem[ma1]]
                                                else:
                                                    i = jt[ma1]
                                            else:
                                                i = i + 1
                                        case 8:
                                            if ma2 >= memlen:
                                                f2 = ma2 - memlen
                                            elif ma2 >= 0:
                                                f2 = mem[ma2]
                                            else:
                                                f2 = ma2
                                            if ma1 >= memlen:
                                                f1 = ma1 - memlen
                                            elif ma1 >= 0:
                                                f1 = mem[ma1]
                                            else:
                                                f1 = ma1
                                            vga(f1 % 56, int(f1 / 56), f2)
                                            d = 1
                                            i = i + 1
                                        case 9:
                                            if ma1 >= memlen:
                                                f1 = ma1 - memlen
                                            elif ma1 >= 0:
                                                f1 = mem[ma1]
                                            else:
                                                f1 = ma1
                                            mem[ma2] = win.key(strsub(" `1234567890-=qwertyuiop[]\\asdfghjkl;'zxcvbnm,./~!@#$%^&*()_+QWERTYUIOP{}|ASDFGHJKL:\"ZXCVBNM<>?", f1, 1))
                                            i = i + 1
                                        case 10:
                                            if ma2 >= memlen:
                                                sleep(ma2 - memlen)
                                            elif ma2 >= 0:
                                                sleep(mem[ma2])
                                            else:
                                                sleep(ma2)
                                            i = i + 1
                                        case 11:
                                            r = 0
                                            break
                                    i = i % la
                                    if d:
                                        win.draw(fb, w * s, h * s)
                                        fc = 64
                                        d = 0
                                    fc = fc + 1
                                    if fc >= 64:
                                        fc = 0
                                        win.tick(1048576)
                                    it = it + 1
                                tt = time() - lt
                                print(strcat("instructions ran: ", str(it)))
                                print(strcat("time taken: ", fmt("%.4f", tt)))
                                print(strcat("time(s) per instruction: ", fmt("%.4f", tt / it)))
                                fb = zeros(w * s * h * s * 4)
                                r = 1
                            else:
                                txt(0, 0, strcat(strcat("kernels/", strsub(l, lc[c * 2], lc[c * 2 + 1])), " is invalid"))
                                win.draw(fb, w * s, h * s)
                                win.tick()
                                sleep(2)
                                fb = zeros(w * s * h * s * 4)
                        else:
                            txt(0, 0, strcat(strcat("kernels/", strsub(l, lc[c * 2], lc[c * 2 + 1])), " is empty"))
                            win.draw(fb, w * s, h * s)
                            win.tick()
                            sleep(2)
                            fb = zeros(w * s * h * s * 4)
                    else:
                        txt(0, 0, strcat(strcat("kernels/", strsub(l, lc[c * 2], lc[c * 2 + 1])), " does not exist"))
                        win.draw(fb, w * s, h * s)
                        win.tick()
                        sleep(2)
                        fb = zeros(w * s * h * s * 4)
                    c = 0
        case 2:
            c = clamp(c - keys[1] + keys[3], 0, 1)
            if c == 1 and keys[4]:
                c = 0
                m = 0
                fb = zeros(w * s * h * s * 4)
    scr(m, c)
    win.draw(fb, w * s, h * s)
    win.tick(30)