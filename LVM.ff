                                            elif ma2 >= 0:
                                                print(str(mem[ma2]))
                                            else:
                                                print(str(ma2))
                                            i = i + 1
                                        case 10:
                                            if ma1 >= memlen:
                                                f1 = ma1 - memlen
                                            elif ma1 >= 0:
                                                f1 = mem[ma1]
                                            else:
                                                f1 = ma1
                                            mem[ma2] = win.key(strsub(" `1234567890-=qwertyuiop[]\\asdfghjkl;'zxcvbnm,./~!@#$%^&*()_+QWERTYUIOP{}|ASDFGHJKL:\"ZXCVBNM<>?", f1, 1))
                                            i = i + 1
                                        case 11:
                                            if ma2 >= memlen:
                                                sleep(ma2 - memlen)
                                            elif ma2 >= 0:
                                                sleep(mem[ma2])
                                            else:
                                                sleep(ma2)
                                            i = i + 1
                                        case 12:
                                            r = 0
                                            break
                                        case 13:
                                            if ma1 >= memlen:
                                                plabel = jt[int(ma1 - memlen)]
                                            elif ma1 >= 0:
                                                plabel = jt[int(mem[int(ma1)])]
                                            else:
                                                plabel = jt[int(ma1)]
                                            pcount = rdm(ma2)
                                            t0 = spawn core(a, a1, a2, mem, jt, plabel, 0, pcount, memlen)
                                            t1 = spawn core(a, a1, a2, mem, jt, plabel, 1, pcount, memlen)
                                            t2 = spawn core(a, a1, a2, mem, jt, plabel, 2, pcount, memlen)
                                            t3 = spawn core(a, a1, a2, mem, jt, plabel, 3, pcount, memlen)
                                            join(t0)
                                            join(t1)
                                            join(t2)
                                            join(t3)
                                            i = i + 1
                                        case 14:
                                            i = i + 1
                                        case 15:
                                            mem[int(ma2)] = 0
                                            i = i + 1
                                        case 16:
                                            lk = int(rdm(ma2))
                                            if lk == 0:
                                                lock0.lock()
                                            elif lk == 1:
                                                lock1.lock()
                                            elif lk == 2:
                                                lock2.lock()
                                            else:
                                                lock3.lock()
                                            i = i + 1
                                        case 17:
                                            lku = int(rdm(ma2))
                                            if lku == 0:
                                                lock0.unlock()
                                            elif lku == 1:
                                                lock1.unlock()
                                            elif lku == 2:
                                                lock2.unlock()
                                            else:
                                                lock3.unlock()
                                            i = i + 1
                                        case 18:
                                            VLEN = rdm(ma2)
                                            i = i + 1
                                        case 19:
                                            gprog = zeros(0)
                                            gconst = zeros(0)
                                            gins = zeros(0)
                                            i = i + 1
                                        case 20:
                                            gins.append(rdm(ma2))
                                            i = i + 1
                                        case 21:
                                            gconst.append(rdm(ma2))
                                            i = i + 1
                                        case 22:
                                            gprog.append(rdm(ma1))
                                            gprog.append(rdm(ma2))
                                            i = i + 1
                                        case 23:
                                            vln = int(VLEN)
                                            nv = len(gins)
                                            pl = int(len(gprog) / 2)
                                            inbuf = gpack(gins, mem, vln)
                                            outbuf = zeros(vln)
                                            run gexec(inbuf, gprog, gconst, nv, pl, vln) -> outbuf size(vln)
                                            gunpack(outbuf, mem, int(rdm(ma2)), vln)
                                            i = i + 1
                                        case 24:
                                            sbase = int(rdm(ma1))
                                            sv = 0.0
                                            for se in range(int(VLEN)):
                                                sv = sv + mem[int(sbase + se)]
                                            mem[int(ma2)] = sv
                                            i = i + 1
                                        case 25:
                                            userline = readline(int(rdm(ma2)))
                                            i = i + 1
                                        case 26:
                                            gguf_parse()
                                            i = i + 1
                                        case 27:
                                            load_emb(int(rdm(ma1)), int(rdm(ma2)))
                                            i = i + 1
                                    i = i % la
                                    if d:
                                        win.draw(fb, w * s, h * s)
                                        fc = 64
                                        d = 0
                                    fc = fc + 1
                                    if fc >= 64:
                                        fc = 0
                                        win.tick(1048576)
                                    it = it + 1
                                tt = time() - lt
                                print(strcat("instructions ran: ", str(it)))
                                print(strcat("time taken: ", fmt("%.4f", tt)))
                                print(strcat("time(s) per instruction: ", fmt("%.4f", tt / it)))
                                fb = zeros(w * s * h * s * 4)
                                r = 1
                            else:
                                txt(0, 0, strcat(strcat("kernels/", strsub(l, lc[c * 2], lc[c * 2 + 1])), " is invalid"))
                                win.draw(fb, w * s, h * s)
                                win.tick()
                                sleep(2)
                                fb = zeros(w * s * h * s * 4)
                        else:
                            txt(0, 0, strcat(strcat("kernels/", strsub(l, lc[c * 2], lc[c * 2 + 1])), " is empty"))
                            win.draw(fb, w * s, h * s)
                            win.tick()
                            sleep(2)
                            fb = zeros(w * s * h * s * 4)
                    else:
                        txt(0, 0, strcat(strcat("kernels/", strsub(l, lc[c * 2], lc[c * 2 + 1])), " does not exist"))
                        win.draw(fb, w * s, h * s)
                        win.tick()
                        sleep(2)
                        fb = zeros(w * s * h * s * 4)
                    c = 0
        case 2:
            c = clamp(c - keys[1] + keys[3], 0, 2)
            switch c:
                case 0:
                    if keys[4]:
                        g[0] = g[0] * 2
                        if g[0] > 16777216:
                            g[0] = 8
                        save_list("config", g)
                        
                case 1:
                    if keys[4]:
                        g[1] = g[1] * 2
                        if g[1] > 2048:
                            g[1] = 4
                        save_list("config", g)
                case 2:
                    if keys[4]:
                        c = 0
                        m = 0
                        fb = zeros(w * s * h * s * 4)
    scr(m, c)
    win.draw(fb, w * s, h * s)
    win.tick(30)